    {
      "id": "pg007_n0001",
      "text": "Sura ya Kwanza"
    },
    {
      "id": "pg007_n0002",
      "text": "Mwili wa binadamu"
    },
    {
      "id": "pg007_n0003",
      "text": "Utangulizi"
    },
    {
      "id": "pg007_n0004",
      "text": "Katika sura hii utajifunza kuhusu mwili wa binadamu.Utabaini"
    },
    {
      "id": "pg007_n0005",
      "text": "sehemu za nje za mwili wa binadamu."
    },
    {
      "id": "pg007_n0006",
      "text": "Vilevile utaelezea kazi"
    },
    {
      "id": "pg007_n0007",
      "text": "za sehemu za nje za mwili wa binadamu."
