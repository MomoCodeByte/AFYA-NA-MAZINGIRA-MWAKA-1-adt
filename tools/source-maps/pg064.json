    {
      "id": "pg064_n0001",
      "text": "Zoezi la 1"
    },
    {
      "id": "pg064_n0002",
      "text": "1."
    },
    {
      "id": "pg064_n0003",
      "text": "Taja wanyama wafugwao nyumbani."
    },
    {
      "id": "pg064_n0004",
      "text": "2."
    },
    {
      "id": "pg064_n0005",
      "text": "Taja faida nne za wanyama wafugwao."
    },
    {
      "id": "pg064_n0006",
      "text": "3."
    },
    {
      "id": "pg064_n0007",
      "text": "Taja wanyama wasiofugwa."
    },
    {
      "id": "pg064_n0008",
      "text": "4."
    },
    {
      "id": "pg064_n0009",
      "text": "Eleza faida mbili za wanyama wasiofugwa."
    },
    {
      "id": "pg064_n0010",
      "text": "5."
    },
    {
      "id": "pg064_n0011",
      "text": "Taja wanyama wasiofugwa wanaopatikana katika"
    },
    {
      "id": "pg064_n0012",
      "text": "mazingira yako."
    },
    {
      "id": "pg064_n0013",
      "text": "Mimea ya aina mbalimbali"
