  "transcript": [
    {
      "id": "pg018_n0001",
      "text": "3."
    },
    {
      "id": "pg018_n0002",
      "text": "Eleza sababu ya kutunza chakula kwa kukining’iniza."
    },
    {
      "id": "pg018_n0003",
      "text": "4."
    },
    {
      "id": "pg018_n0004",
      "text": "Orodhesha vifaa vinavyotumika kutunza chakula."
    },
    {
      "id": "pg018_n0005",
      "text": "5."
    },
    {
      "id": "pg018_n0006",
      "text": "Taja njia nyingine mbili za kutunza chakula."
    },
    {
      "id": "pg018_n0007",
      "text": "Maji safi na salama"
    },
    {
      "id": "pg018_n0008",
      "text": "Maji ni muhimu katika maisha."
    },
    {
      "id": "pg018_n0009",
      "text": "Unaweza kupata maji kutoka"
    },
    {
      "id": "pg018_n0010",
      "text": "sehemu mbalimbali."
    },
    {
      "id": "pg018_n0011",
      "text": "Sehemu hizo ni kama mito, mabomba na"
    },
    {
      "id": "pg018_n0012",
      "text": "visima."
    },
    {
      "id": "pg018_n0013",
      "text": "Hatua za kupata maji safi na salama"
    },
    {
      "id": "pg018_n0014",
      "text": "1 2 3"
    },
    {
      "id": "pg018_n0015",
      "text": "Kuchemsha maji Maji yanapoa"
    },
    {
      "id": "pg018_n0016",
      "text": "Kuchuja maji"
    },
    {
      "id": "pg018_n0017",
      "text": "4 5"
    },
    {
      "id": "pg018_n0018",
      "text": "Kuhifadhi maji kwenye Kunywa maji safi na"
    },
    {
      "id": "pg018_n0019",
      "text": "chombo safi salama"
    },
    {
      "id": "pg018_n0020",
      "text": "12"
    },
    {
