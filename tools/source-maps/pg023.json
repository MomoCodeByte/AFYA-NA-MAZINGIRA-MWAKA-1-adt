  "transcript": [
    {
      "id": "pg023_n0001",
      "text": "Zoezi la 5"
    },
    {
      "id": "pg023_n0002",
      "text": "Katika vikundi vidogo vidogo, jadili maswali yafuatayo"
    },
    {
      "id": "pg023_n0003",
      "text": "1."
    },
    {
      "id": "pg023_n0004",
      "text": "Kwanini tunashauriwa kufanya mazoezi kila siku"
    },
    {
      "id": "pg023_n0005",
      "text": "2."
    },
    {
      "id": "pg023_n0006",
      "text": "Taja mifano ya mazoezi yanayosaidia kujenga na"
    },
    {
      "id": "pg023_n0007",
      "text": "kuimarisha misuli ya mwili"
    },
    {
      "id": "pg023_n0008",
      "text": "Afya bora husaidia mwili kujikinga na magonjwa mbali mbali."
    },
    {
      "id": "pg023_n0009",
      "text": "Katika sura ya tatu tutajifunza njia mbali mbali za kujikinga"
    },
    {
      "id": "pg023_n0010",
      "text": "na magonjwa."
    },
    {
      "id": "pg023_n0011",
      "text": "1177"
    },
    {
      "id": "pg023_n0012",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 17 23/07/2021 15:41"
    }
  ]
