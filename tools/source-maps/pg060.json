      "text": "4."
    },
    {
      "id": "pg060_n0007",
      "text": "Katika mazingira tunayoishi kuna viumbe hai mbalimbali."
    },
    {
      "id": "pg060_n0008",
      "text": "Viumbe hao ni kama vile paka, mbuzi, ng'ombe na miti."
