  "transcript": [
    {
      "id": "pg031_n0001",
      "text": "Kwa nini tunasafisha nywele?"
    },
    {
      "id": "pg031_n0002",
      "text": "Nywele hushika vumbi kwa urahisi."
    },
    {
      "id": "pg031_n0003",
      "text": "Yafaa nywele zitunzwe"
    },
    {
      "id": "pg031_n0004",
      "text": "kwa kuoshwa kwa maji safi na sabuni."
    },
    {
      "id": "pg031_n0005",
      "text": "Pia, zikatwe ili ziwe"
    },
    {
      "id": "pg031_n0006",
      "text": "fupi na zipendeze."
    },
    {
      "id": "pg031_n0007",
      "text": "Nywele chafu husababisha harufu mbaya ya"
    },
    {
      "id": "pg031_n0008",
      "text": "jasho."
    },
    {
      "id": "pg031_n0009",
      "text": "Vilevile, huweza kuhifadhi wadudu kama chawa."
    },
    {
      "id": "pg031_n0010",
      "text": "Chawa"
    },
    {
      "id": "pg031_n0011",
      "text": "hunyonya damu na kusababisha homa."
    },
    {
      "id": "pg031_n0012",
      "text": "Nywele zisafishwe"
    },
    {
      "id": "pg031_n0013",
      "text": "kuepuka magonjwa ya mba na mapunye."
    },
    {
      "id": "pg031_n0014",
      "text": "Nywele zinafaa"
    },
    {
      "id": "pg031_n0015",
      "text": "kusafishwa kila siku."
    },
    {
      "id": "pg031_n0016",
      "text": "Pia, tunyoe nywele mara kwa mara."
    },
    {
      "id": "pg031_n0017",
      "text": "Tuepuke kuchangia vifaa vya kunyolea nywele."
    },
    {
      "id": "pg031_n0018",
      "text": "Tukichangia"
    },
    {
      "id": "pg031_n0019",
      "text": "vifaa tutapata maambukizi ya magonjwa."
    },
    {
      "id": "pg031_n0020",
      "text": "Magonjwa hayo ni"
    },
    {
      "id": "pg031_n0021",
      "text": "mba, mapunye na VVU."
    },
    {
      "id": "pg031_n0022",
      "text": "Mtoto mwenye mapunye"
    },
    {
      "id": "pg031_n0023",
      "text": "Zoezi la 4"
    },
    {
      "id": "pg031_n0024",
      "text": "1."
    },
    {
      "id": "pg031_n0025",
      "text": "Andika faida nne za kunyoa nywele."
    },
    {
      "id": "pg031_n0026",
      "text": "2."
    },
    {
      "id": "pg031_n0027",
      "text": "Nywele chafu zina madhara gani?"
    },
    {
      "id": "pg031_n0028",
      "text": "3."
    },
    {
      "id": "pg031_n0029",
      "text": "Ni mdudu gani hupatikana kwenye nywele chafu?"
    },
    {
      "id": "pg031_n0030",
      "text": "4."
    },
    {
      "id": "pg031_n0031",
      "text": "Kuchangia vifaa vya kunyolea nywele kunasababisha"
    },
    {
      "id": "pg031_n0032",
      "text": "magonjwa gani?"
    },
    {
      "id": "pg031_n0033",
      "text": "2255"
    },
    {
      "id": "pg031_n0034",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 25 23/07/2021 15:41"
    }
  ]
