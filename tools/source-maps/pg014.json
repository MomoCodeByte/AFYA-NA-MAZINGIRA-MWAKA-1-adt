  "transcript": [
    {
      "id": "pg014_n0001",
      "text": "Sura ya Pili"
    },
    {
      "id": "pg014_n0002",
      "text": "Afya bora"
    },
    {
      "id": "pg014_n0003",
      "text": "Utangulizi"
    },
    {
      "id": "pg014_n0004",
      "text": "Chakula bora na salama ni muhimu sana kwa ajili ya afya"
    },
    {
      "id": "pg014_n0005",
      "text": "ya mwili."
    },
    {
      "id": "pg014_n0006",
      "text": "Husaidia mwili kujenga uwezo wa kupambana na"
    },
    {
      "id": "pg014_n0007",
      "text": "magonjwa mbalimbali."
    },
    {
      "id": "pg014_n0008",
      "text": "Katika sura hii, utajifunza kuhusu"
    },
    {
      "id": "pg014_n0009",
      "text": "chakula bora na salama."
    },
    {
      "id": "pg014_n0010",
      "text": "Vile vile utajifunza kuhusu umuhimu"
    },
    {
      "id": "pg014_n0011",
      "text": "wa mazoezi katika afya ya mwili."
    },
    {
      "id": "pg014_n0012",
      "text": "Vyakula vinavyoliwa asubuhi, mchana na jioni"
    },
    {
      "id": "pg014_n0013",
      "text": "Wimbo"
    },
    {
      "id": "pg014_n0014",
      "text": "1."
    },
    {
      "id": "pg014_n0015",
      "text": "Tule chakula vizuri tule asubuhi, mchana na jioni x 2"
    },
    {
      "id": "pg014_n0016",
      "text": "Asubuhi kunywa maziwa na viazi, chai na mihogo x 2"
    },
    {
      "id": "pg014_n0017",
      "text": "2."
    },
    {
      "id": "pg014_n0018",
      "text": "Mchana twaweza kula ugali na wali samaki, nyama,"
    },
    {
      "id": "pg014_n0019",
      "text": "pamoja na matunda x 2"
    },
    {
      "id": "pg014_n0020",
      "text": "Jioni twaweza kula ndizi nyama."
    },
    {
      "id": "pg014_n0021",
      "text": "Ugali na wali tulale"
    },
    {
      "id": "pg014_n0022",
      "text": "salama jamani x 2"
    },
    {
      "id": "pg014_n0023",
      "text": "3."
    },
    {
      "id": "pg014_n0024",
      "text": "Tule vyakula vyote hivi kwa afya tukiwa na afya twahesabu"
    },
    {
      "id": "pg014_n0025",
      "text": "vema x 2"
    },
    {
      "id": "pg014_n0026",
      "text": "Waweza pia kusoma vizuri jamani."
    },
    {
      "id": "pg014_n0027",
      "text": "Twaweza cheza bila"
    },
    {
      "id": "pg014_n0028",
      "text": "shida kwa furaha x 2"
    },
    {
      "id": "pg014_n0029",
      "text": "Vyakula vinavyoliwa asubuhi"
    },
    {
      "id": "pg014_n0030",
      "text": "mboga za"
    },
    {
      "id": "pg014_n0031",
      "text": "uji mkate maandazi maziwa"
    },
    {
      "id": "pg014_n0032",
      "text": "majani"
    },
    {
      "id": "pg014_n0033",
      "text": "mihogo chai viazi maji ya kunywa ndizi"
    },
    {
      "id": "pg014_n0034",
      "text": "8"
    },
    {
      "id": "pg014_n0035",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 8 23/07/2021 15:41"
    }
  ]
