  "transcript": [
    {
      "id": "pg045_n0001",
      "text": "Njia za kujikinga na Virusi vya UKIMWI (VVU)"
    },
    {
      "id": "pg045_n0002",
      "text": "UKIMWI ni kifupi cha Upungufu wa Kinga Mwilini."
    },
    {
      "id": "pg045_n0003",
      "text": "VVU ni kifupi cha Virusi vya UKIMWI."
    },
    {
      "id": "pg045_n0004",
      "text": "Vifaa vinavyochangia maambukizi ya VVU"
    },
    {
      "id": "pg045_n0005",
      "text": "wembe mswaki sindano ya kutogea masikio"
    },
    {
      "id": "pg045_n0006",
      "text": "au kushonea nguo"
    },
    {
      "id": "pg045_n0007",
      "text": "kitana"
    },
    {
      "id": "pg045_n0008",
      "text": "chanuo"
    },
    {
      "id": "pg045_n0009",
      "text": "pini"
    },
    {
      "id": "pg045_n0010",
      "text": "sindano"
    },
    {
      "id": "pg045_n0011",
      "text": "Soma habari hii, kisha jibu maswali"
    },
    {
      "id": "pg045_n0012",
      "text": "Furaha ni mwalimu katika shule ya Mpakani."
    },
    {
      "id": "pg045_n0013",
      "text": "Aliwafundisha"
    },
    {
      "id": "pg045_n0014",
      "text": "wanafunzi kujikinga na Virusi vya UKIMWI."
    },
    {
      "id": "pg045_n0015",
      "text": "Mwanafunzi"
    },
    {
      "id": "pg045_n0016",
      "text": "mmoja alimuuliza mwalimu, utamtambuaje mtu mwenye"
    },
    {
      "id": "pg045_n0017",
      "text": "VVU?"
    },
    {
      "id": "pg045_n0018",
      "text": "Mwalimu alijibu, kwamba huwezi kumtambua kwa"
    },
    {
      "id": "pg045_n0019",
      "text": "kumwangalia kwa macho."
    },
    {
      "id": "pg045_n0020",
      "text": "Ili kumtambua ni lazima apimwe"
    },
    {
      "id": "pg045_n0021",
      "text": "hospitalini."
    },
    {
      "id": "pg045_n0022",
      "text": "Mwanafunzi mwingine aliuliza, tunawezaje kupata"
    },
    {
      "id": "pg045_n0023",
      "text": "maambukizi ya VVU?"
    },
    {
      "id": "pg045_n0024",
      "text": "Mwalimu alisema ni kwa kuchangia"
    },
    {
      "id": "pg045_n0025",
      "text": "vifaa vyenye ncha kali."
    },
    {
      "id": "pg045_n0026",
      "text": "Mfano wa vifaa hivyo ni sindano, pini"
    },
    {
      "id": "pg045_n0027",
      "text": "na nyembe."
    },
    {
      "id": "pg045_n0028",
      "text": "Vilevile vifaa vya usafi kama vitana, chanuo na"
    },
    {
      "id": "pg045_n0029",
      "text": "miswaki."
    },
    {
      "id": "pg045_n0030",
      "text": "Pia taulo, dodoki na vifaa vya kunyolea nywele."
    },
    {
      "id": "pg045_n0031",
      "text": "3399"
    },
    {
      "id": "pg045_n0032",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 39 23/07/2021 15:41"
    }
  ]
