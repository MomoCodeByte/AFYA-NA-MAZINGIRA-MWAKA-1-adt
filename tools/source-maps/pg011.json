  "transcript": [
    {
      "id": "pg011_n0001",
      "text": "Kutambua harufu ya vitu mbalimbali"
    },
    {
      "id": "pg011_n0002",
      "text": "Soma habari hii, kisha jibu maswali."
    },
    {
      "id": "pg011_n0003",
      "text": "Amani na Upendo wanasoma Darasa la Pili."
    },
    {
      "id": "pg011_n0004",
      "text": "Siku moja"
    },
    {
      "id": "pg011_n0005",
      "text": "walipotoka shuleni walikuwa na mazungumzo haya."
    },
    {
      "id": "pg011_n0006",
      "text": "Amani: Hivi ile harufu mbaya darasani huwa inatoka"
    },
    {
      "id": "pg011_n0007",
      "text": "wapi?"
    },
    {
      "id": "pg011_n0008",
      "text": "Upendo: Sijui inatoka wapi."
    },
    {
      "id": "pg011_n0009",
      "text": "Amani: Nafikiri kuna baadhi ya wanafunzi hawaogi."
    },
    {
      "id": "pg011_n0010",
      "text": "Upendo: Inawezekana wanaoga ila wanavaa nguo chafu."
    },
    {
      "id": "pg011_n0011",
      "text": "Amani: Kwani nguo chafu husababisha harufu mbaya?"
    },
    {
      "id": "pg011_n0012",
      "text": "Upendo: Ndiyo, tena nguo chafu huhifadhi vijidudu vya"
    },
    {
      "id": "pg011_n0013",
      "text": "magonjwa."
    },
    {
      "id": "pg011_n0014",
      "text": "Amani: Lazima tumweleze mwalimu wa afya ili atukague."
    },
    {
      "id": "pg011_n0015",
      "text": "Siku iliyofuata Amani alimweleza mwalimu ili wakaguliwe."
    },
    {
      "id": "pg011_n0016",
      "text": "Mwalimu alikagua mavazi ya kila mwanafunzi."
    },
    {
      "id": "pg011_n0017",
      "text": "Alipomfikia"
    },
    {
      "id": "pg011_n0018",
      "text": "Papi, harufu mbaya ilizidi."
    },
    {
      "id": "pg011_n0019",
      "text": "Akamwambia Papi avue viatu."
    },
    {
      "id": "pg011_n0020",
      "text": "Aligundua soksi za Papi zilikuwa zinatoa harufu mbaya."
    },
    {
      "id": "pg011_n0021",
      "text": "Akamwambia avue soksi azipeleke nje na akaoshe miguu."
    },
    {
      "id": "pg011_n0022",
      "text": "Mwalimu aliwaeleza ili nguo zisinuke vibaya lazima zifuliwe."
    },
    {
      "id": "pg011_n0023",
      "text": "Pia zianikwe kwenye jua ili zikauke vizuri."
    },
    {
      "id": "pg011_n0024",
      "text": "Baada ya masomo"
    },
    {
      "id": "pg011_n0025",
      "text": "Papi alirudi nyumbani."
    },
    {
      "id": "pg011_n0026",
      "text": "Alipofika nyumbani alivua sare ya shule"
    },
    {
      "id": "pg011_n0027",
      "text": "na kufua."
    },
    {
      "id": "pg011_n0028",
      "text": "Siku iliyofuata Amani na Upendo hawakuhisi harufu"
    },
    {
      "id": "pg011_n0029",
      "text": "mbaya tena."
    },
    {
      "id": "pg011_n0030",
      "text": "Tunahisi harufu mbalimbali kwa kutumia pua."
    },
    {
      "id": "pg011_n0031",
      "text": "55"
    },
    {
      "id": "pg011_n0032",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 5 23/07/2021 15:41"
    }
  ]
