  "transcript": [
    {
      "id": "pg061_n0001",
      "text": "Sura ya Tano"
    },
    {
      "id": "pg061_n0002",
      "text": "Viumbe hai katika mazingira"
    },
    {
      "id": "pg061_n0003",
      "text": "Utangulizi"
    },
    {
      "id": "pg061_n0004",
      "text": "Katika sura hii utajifunza kuhusu viumbe hai."
    },
    {
      "id": "pg061_n0005",
      "text": "Utaweza kubaini"
    },
    {
      "id": "pg061_n0006",
      "text": "aina mbalimbali ya wanyama na mimea, Vilevile utaelezea"
    },
    {
      "id": "pg061_n0007",
      "text": "faida za wanyama na mimea katika maisha yako ya kila siku."
    },
    {
      "id": "pg061_n0008",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg061_n0009",
      "text": "Elezea kwa kifupi vitu unavyoviona katika picha"
    },
    {
      "id": "pg061_n0010",
      "text": "Kutambua wanyama mbalimbali"
    },
    {
      "id": "pg061_n0011",
      "text": "Paka Mjusi"
    },
    {
      "id": "pg061_n0012",
      "text": "5555"
    },
