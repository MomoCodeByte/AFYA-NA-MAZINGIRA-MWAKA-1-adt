  "transcript": [
    {
      "id": "pg034_n0001",
      "text": "Kufua nguo"
    },
    {
      "id": "pg034_n0002",
      "text": "Soma habari hii, kisha jibu maswali yanayofuata."
    },
    {
      "id": "pg034_n0003",
      "text": "Wanafunzi wa Darasa la Pili walifundishwa kufua nguo."
    },
    {
      "id": "pg034_n0004",
      "text": "Walielezwa kuwa nguo hufuliwa ili kuondoa uchafu."
    },
    {
      "id": "pg034_n0005",
      "text": "Uchafu"
    },
    {
      "id": "pg034_n0006",
      "text": "huo husababisha magonjwa ya ngozi."
    },
    {
      "id": "pg034_n0007",
      "text": "Magonjwa hayo ni"
    },
    {
      "id": "pg034_n0008",
      "text": "kama vile upele, fangasi na miwasho."
    },
    {
      "id": "pg034_n0009",
      "text": "Nguo safi hudumu na"
    },
    {
      "id": "pg034_n0010",
      "text": "kupendeza."
    },
    {
      "id": "pg034_n0011",
      "text": "Nguo chafu huhifadhi chawa."
    },
    {
      "id": "pg034_n0012",
      "text": "Soksi na nguo za"
    },
    {
      "id": "pg034_n0013",
      "text": "ndani zifuliwe kila siku."
    },
    {
      "id": "pg034_n0014",
      "text": "Tunapofua tutenganishe nguo nyeupe"
    },
    {
      "id": "pg034_n0015",
      "text": "na za rangi."
    },
    {
      "id": "pg034_n0016",
      "text": "Nguo zifuliwe kwa maji safi na sabuni."
    },
    {
      "id": "pg034_n0017",
      "text": "Zisuuzwe"
    },
    {
      "id": "pg034_n0018",
      "text": "vizuri kwenye maji safi, kisha zianikwe juani."
    },
    {
      "id": "pg034_n0019",
      "text": "Maswali"
    },
    {
      "id": "pg034_n0020",
      "text": "1."
    },
    {
      "id": "pg034_n0021",
      "text": "Kwa nini tunafua nguo?"
    },
    {
      "id": "pg034_n0022",
      "text": "2."
    },
    {
      "id": "pg034_n0023",
      "text": "Taja nguo zinazotakiwa kufuliwa kila siku."
    },
    {
      "id": "pg034_n0024",
      "text": "3."
    },
    {
      "id": "pg034_n0025",
      "text": "Tunafua nguo kwa kutumia nini?"
    },
    {
      "id": "pg034_n0026",
      "text": "4."
    },
    {
      "id": "pg034_n0027",
      "text": "Nguo chafu husababisha magonjwa gani?"
    },
    {
      "id": "pg034_n0028",
      "text": "Vifaa vya kufulia nguo"
    },
    {
      "id": "pg034_n0029",
      "text": "sabuni ya mche"
    },
    {
      "id": "pg034_n0030",
      "text": "sabuni ya unga"
    },
    {
      "id": "pg034_n0031",
      "text": "beseni la maji ndoo ya maji vibanio"
    },
    {
      "id": "pg034_n0032",
      "text": "28"
    },
    {
      "id": "pg034_n0033",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 28 23/07/2021 15:41"
    }
  ]
