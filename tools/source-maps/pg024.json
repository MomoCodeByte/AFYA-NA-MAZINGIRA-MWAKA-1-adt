  "transcript": [
    {
      "id": "pg024_n0001",
      "text": "Sura ya Tatu"
    },
    {
      "id": "pg024_n0002",
      "text": "Njia mbalimbali za kujikinga na magonjwa"
    },
    {
      "id": "pg024_n0003",
      "text": "Utangulizi"
    },
    {
      "id": "pg024_n0004",
      "text": "Katika sura hii, utajifunza njia mbalimbali za kujikinga na"
    },
    {
      "id": "pg024_n0005",
      "text": "magonjwa."
    },
    {
      "id": "pg024_n0006",
      "text": "Njia hizo ni usafi wa mwili na mavazi, usafi wa"
    },
    {
      "id": "pg024_n0007",
      "text": "vyombo vya chakula na njia sahihi ya matumizi ya choo."
    },
    {
      "id": "pg024_n0008",
      "text": "Pia"
    },
    {
      "id": "pg024_n0009",
      "text": "utajifunza njia za kujikinga na virusi vya UKIMWI (VVU)."
    },
    {
      "id": "pg024_n0010",
      "text": "Usafi wa mwili"
    },
    {
      "id": "pg024_n0011",
      "text": "Usafi wa kinywa"
    },
    {
      "id": "pg024_n0012",
      "text": "Hatua za Kusafisha Kinywa"
    },
    {
      "id": "pg024_n0013",
      "text": "mswaki wa mswaki wa dawa ya"
    },
    {
      "id": "pg024_n0014",
      "text": "maji safi na"
    },
    {
      "id": "pg024_n0015",
      "text": "brashi mti meno"
    },
    {
      "id": "pg024_n0016",
      "text": "salama"
    },
    {
      "id": "pg024_n0017",
      "text": "18"
    },
    {
      "id": "pg024_n0018",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 18 23/07/2021 15:41"
    }
  ]
}