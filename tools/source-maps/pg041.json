  "transcript": [
    {
      "id": "pg041_n0001",
      "text": "6."
    },
    {
      "id": "pg041_n0002",
      "text": "Hifadhi vyombo mahali safi ili visichafuke."
    },
    {
      "id": "pg041_n0003",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg041_n0004",
      "text": "Osha vyombo vya chakula kwa kufuata hatua."
    },
    {
      "id": "pg041_n0005",
      "text": "Zoezi la 10"
    },
    {
      "id": "pg041_n0006",
      "text": "1."
    },
    {
      "id": "pg041_n0007",
      "text": "Taja vifaa vinne vinavyotumika kusafishia vyombo vya"
    },
    {
      "id": "pg041_n0008",
      "text": "chakula."
    },
    {
      "id": "pg041_n0009",
      "text": "2."
    },
    {
      "id": "pg041_n0010",
      "text": "Andika majina ya vyombo ulivyowahi kuviosha."
    },
    {
      "id": "pg041_n0011",
      "text": "3."
    },
    {
      "id": "pg041_n0012",
      "text": "Taja sehemu nne za kuhifadhi vyombo vilivyooshwa."
    },
    {
      "id": "pg041_n0013",
      "text": "4."
    },
    {
      "id": "pg041_n0014",
      "text": "Orodhesha magonjwa yanayosababishwa na matumizi ya"
    },
    {
      "id": "pg041_n0015",
      "text": "vyombo vichafu."
    },
    {
      "id": "pg041_n0016",
      "text": "5."
    },
    {
      "id": "pg041_n0017",
      "text": "Taja wadudu wanaovutiwa na vyombo vichafu."
    },
    {
      "id": "pg041_n0018",
      "text": "6."
    },
    {
      "id": "pg041_n0019",
      "text": "Taja sababu mbili za kuosha vyombo vya chakula."
    },
    {
      "id": "pg041_n0020",
      "text": "3355"
    },
    {
      "id": "pg041_n0021",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 35 23/07/2021 15:41"
    }
