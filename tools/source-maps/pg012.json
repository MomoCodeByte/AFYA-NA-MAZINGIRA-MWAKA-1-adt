  "transcript": [
    {
      "id": "pg012_n0001",
      "text": "Maswali"
    },
    {
      "id": "pg012_n0002",
      "text": "1."
    },
    {
      "id": "pg012_n0003",
      "text": "Katika habari hii umejifunza nini?"
    },
    {
      "id": "pg012_n0004",
      "text": "2."
    },
    {
      "id": "pg012_n0005",
      "text": "Mazungumzo yalianzishwa na ____________ na"
    },
    {
      "id": "pg012_n0006",
      "text": "___________."
    },
    {
      "id": "pg012_n0007",
      "text": "3."
    },
    {
      "id": "pg012_n0008",
      "text": "Walitumia kiungo gani cha mwili katika mazungumzo?"
    },
    {
      "id": "pg012_n0009",
      "text": "4."
    },
    {
      "id": "pg012_n0010",
      "text": "Kiungo gani cha mwili kilitumika kutambua harufu?"
    },
    {
      "id": "pg012_n0011",
      "text": "5."
    },
    {
      "id": "pg012_n0012",
      "text": "Andika vitu vitatu vinavyotoa harufu mbaya."
    },
    {
      "id": "pg012_n0013",
      "text": "6."
    },
    {
      "id": "pg012_n0014",
      "text": "Andika vitu vinne vinavyotoa harufu nzuri."
    },
    {
      "id": "pg012_n0015",
      "text": "Zoezi la 3"
    },
    {
      "id": "pg012_n0016",
      "text": "Tumia maneno yafuatayo kukamilisha sentensi hizi."
    },
    {
      "id": "pg012_n0017",
      "text": "Mdomo, Upendo, juani, pua, Papi, mavazi, ngozi, ndani"
    },
    {
      "id": "pg012_n0018",
      "text": "1."
    },
    {
      "id": "pg012_n0019",
      "text": "Sehemu ya mwili iliyotumika kunusa ni...................."
    },
    {
      "id": "pg012_n0020",
      "text": "2."
    },
    {
      "id": "pg012_n0021",
      "text": "Baada ya nguo kufuliwa huanikwa.........................."
    },
    {
      "id": "pg012_n0022",
      "text": "3."
    },
    {
      "id": "pg012_n0023",
      "text": "Soksi za nani zilitoa harufu mbaya?"
    },
    {
      "id": "pg012_n0024",
      "text": "........................."
    },
    {
      "id": "pg012_n0025",
      "text": "4."
    },
    {
      "id": "pg012_n0026",
      "text": "Mwalimu alikagua nini?"
    },
    {
      "id": "pg012_n0027",
      "text": "............................................."
    },
    {
      "id": "pg012_n0028",
      "text": "6"
    },
