  "transcript": [
    {
      "id": "pg057_n0001",
      "text": "Mimi ni simba."
    },
    {
      "id": "pg057_n0002",
      "text": "Ni mfalme wa"
    },
    {
      "id": "pg057_n0003",
      "text": "pori."
    },
    {
      "id": "pg057_n0004",
      "text": "Binadamu huniogopa."
    },
    {
      "id": "pg057_n0005",
      "text": "Mimi ni nge."
    },
    {
      "id": "pg057_n0006",
      "text": "Sumu yangu Mimi ni mbu."
    },
    {
      "id": "pg057_n0007",
      "text": "Huwanyonya"
    },
    {
      "id": "pg057_n0008",
      "text": "ni kali."
    },
    {
      "id": "pg057_n0009",
      "text": "Huwaletea maumivu damu na kuwaletea vijidudu"
    },
    {
      "id": "pg057_n0010",
      "text": "makali."
    },
    {
      "id": "pg057_n0011",
      "text": "vya malaria"
    },
    {
      "id": "pg057_n0012",
      "text": "Zoezi la 3"
    },
    {
      "id": "pg057_n0013",
      "text": "1."
    },
    {
      "id": "pg057_n0014",
      "text": "Orodhesha viumbe hatarishi nane unavyovifahamu."
    },
    {
      "id": "pg057_n0015",
      "text": "2."
    },
    {
      "id": "pg057_n0016",
      "text": "Taja viumbe hatarishi wanaopatikana katika mazingira ya"
    },
    {
      "id": "pg057_n0017",
      "text": "nyumbani."
    },
    {
      "id": "pg057_n0018",
      "text": "3."
    },
    {
      "id": "pg057_n0019",
      "text": "Kwa nini mbu ni kiumbe hatarishi kwa binadamu?"
    },
    {
      "id": "pg057_n0020",
      "text": "4."
    },
    {
      "id": "pg057_n0021",
      "text": "Taja viumbe hatarishi wanaopatikana porini."
    },
    {
      "id": "pg057_n0022",
      "text": "5."
    },
    {
      "id": "pg057_n0023",
      "text": "Taja viumbe hatarishi wanaopatikana katika mazingira ya"
    },
    {
      "id": "pg057_n0024",
      "text": "shule."
    },
    {
      "id": "pg057_n0025",
      "text": "5511"
