  "transcript": [
    {
      "id": "pg058_n0001",
      "text": "Matumizi ya alama za tahadhari katika mazingira yetu"
    },
    {
      "id": "pg058_n0002",
      "text": "Alama za tahadhari hutumika kuonya, kukataza na kuelekeza."
    },
    {
      "id": "pg058_n0003",
      "text": "Vilevile, hutambulisha hatari inayoweza kutokea endapo"
    },
    {
      "id": "pg058_n0004",
      "text": "hutofuata maelekezo."
    },
    {
      "id": "pg058_n0005",
      "text": "Zifuatazo ni baadhi ya alama za"
    },
    {
      "id": "pg058_n0006",
      "text": "tahadhari."
    },
    {
      "id": "pg058_n0007",
      "text": "Alama ya moto Alama ya umeme mkubwa"
    },
    {
      "id": "pg058_n0008",
      "text": "Alama ya hatari Alama ya usafi wa mazingira"
    },
    {
      "id": "pg058_n0009",
      "text": "Alama ya kivuko cha Alama ya mlipuko"
    },
    {
      "id": "pg058_n0010",
      "text": "waenda kwa miguu"
    },
    {
      "id": "pg058_n0011",
      "text": "Alama ya hifadhi ya Alama ya reli inakatisha"
    },
    {
      "id": "pg058_n0012",
      "text": "wanyama"
    },
    {
      "id": "pg058_n0013",
      "text": "52"
    },
    {
      "id": "pg058_n0014",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 52 23/07/2021 15:42"
    }
