  "transcript": [
    {
      "id": "pg048_n0001",
      "text": "Sura ya Nne"
    },
    {
      "id": "pg048_n0002",
      "text": "Mazingira yetu"
    },
    {
      "id": "pg048_n0003",
      "text": "Utangulizi"
    },
    {
      "id": "pg048_n0004",
      "text": "Katika sura hii utajifunza kuhusu mazingira, ambapo utaweza"
    },
    {
      "id": "pg048_n0005",
      "text": "kubaini vifaa vinavyotumika katika kusafisha mazingira."
    },
    {
      "id": "pg048_n0006",
      "text": "Vilevile"
    },
    {
      "id": "pg048_n0007",
      "text": "utajifunza namna ya kupanda miche kwa kuzingatia kanuni na"
    },
    {
      "id": "pg048_n0008",
      "text": "kuitunza."
    },
    {
      "id": "pg048_n0009",
      "text": "Pia, utabaini vitendo hatarishi katika mazingira na"
    },
    {
      "id": "pg048_n0010",
      "text": "viumbe hatarishi."
    },
    {
      "id": "pg048_n0011",
      "text": "Mwisho, utajifunza alama za tahadhari na"
    },
    {
      "id": "pg048_n0012",
      "text": "matumizi yake."
    },
    {
      "id": "pg048_n0013",
      "text": "Vifaa vya kutunzia mazingira"
    },
    {
      "id": "pg048_n0014",
      "text": "Mazingira husafishwa kwa kutumia vifaa mbalimbali."
    },
    {
      "id": "pg048_n0015",
      "text": "Vifaa vya kusafishia mazingira"
    },
    {
      "id": "pg048_n0016",
      "text": "42"
    },
    {
      "id": "pg048_n0017",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 42 23/07/2021 15:41"
    }
  ]
