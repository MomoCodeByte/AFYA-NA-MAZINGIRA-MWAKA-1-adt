  "transcript": [
    {
      "id": "pg072_n0001",
      "text": "Maswali"
    },
    {
      "id": "pg072_n0002",
      "text": "1."
    },
    {
      "id": "pg072_n0003",
      "text": "Kwa nini Shukuru alivaa glovu kabla ya kumhudumia Tuli?"
    },
    {
      "id": "pg072_n0004",
      "text": "2."
    },
    {
      "id": "pg072_n0005",
      "text": "Tuli alipata michubuko sehemu gani ya mwili?"
    },
    {
      "id": "pg072_n0006",
      "text": "3."
    },
    {
      "id": "pg072_n0007",
      "text": "Shukuru alibeba nini baada ya kutoa taarifa?"
    },
    {
      "id": "pg072_n0008",
      "text": "4."
    },
    {
      "id": "pg072_n0009",
      "text": "Tuli alipelekwa wapi baada ya huduma ya kwanza?"
    },
    {
      "id": "pg072_n0010",
      "text": "Zoezi la 3"
    },
    {
      "id": "pg072_n0011",
      "text": "1."
    },
    {
      "id": "pg072_n0012",
      "text": "Orodhesha vifaa vya sanduku la huduma ya kwanza."
    },
    {
      "id": "pg072_n0013",
      "text": "2."
    },
    {
      "id": "pg072_n0014",
      "text": "Taja dawa inayoua vijidudu."
    },
    {
      "id": "pg072_n0015",
      "text": "3."
    },
    {
      "id": "pg072_n0016",
      "text": "Kwa nini ni hatari kuchezea nyaya za umeme?"
    },
    {
      "id": "pg072_n0017",
      "text": "4."
    },
    {
      "id": "pg072_n0018",
      "text": "Utafanya nini kumsaidia mtu aliyenaswa na umeme?"
    },
    {
      "id": "pg072_n0019",
      "text": "5."
    },
    {
      "id": "pg072_n0020",
      "text": "Taja vifaa vitano alivyonunua mama yake Tuli."
    },
    {
      "id": "pg072_n0021",
      "text": "66"
    },
    {
      "id": "pg072_n0022",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 66 23/07/2021 15:42"
    }
  ]
}