  "transcript": [
    {
      "id": "pg036_n0001",
      "text": "5"
    },
    {
      "id": "pg036_n0002",
      "text": "Zoezi la 6"
    },
    {
      "id": "pg036_n0003",
      "text": "Panga sentensi kwa mtiririko wa matukio katika picha."
    },
    {
      "id": "pg036_n0004",
      "text": "1."
    },
    {
      "id": "pg036_n0005",
      "text": "Suuza nguo kwa maji safi, kisha kamua."
    },
    {
      "id": "pg036_n0006",
      "text": "2."
    },
    {
      "id": "pg036_n0007",
      "text": "Anika nguo kwenye kamba na kuzibana kwa vibanio."
    },
    {
      "id": "pg036_n0008",
      "text": "3."
    },
    {
      "id": "pg036_n0009",
      "text": "Tenganisha nguo za rangi na nyeupe, kisha loweka."
    },
    {
      "id": "pg036_n0010",
      "text": "4."
    },
    {
      "id": "pg036_n0011",
      "text": "Fikicha nguo kuondoa uchafu."
    },
    {
      "id": "pg036_n0012",
      "text": "5."
    },
    {
      "id": "pg036_n0013",
      "text": "Geuza nguo kabla ya kuanika."
    },
    {
      "id": "pg036_n0014",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg036_n0015",
      "text": "1."
    },
    {
      "id": "pg036_n0016",
      "text": "Fua nguo kwa kufuata hatua za ufuaji."
    },
    {
      "id": "pg036_n0017",
      "text": "2."
    },
    {
      "id": "pg036_n0018",
      "text": "Eleza umejifunza nini kipya katika ufuaji wa nguo"
    },
    {
      "id": "pg036_n0019",
      "text": "ukilinganisha na kabla ya kujifunza."
    },
    {
      "id": "pg036_n0020",
      "text": "30"
    },
    {
      "id": "pg036_n0021",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 30 23/07/2021 15:41"
    }
  ]
