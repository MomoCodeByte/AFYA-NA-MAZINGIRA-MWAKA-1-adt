  "transcript": [
    {
      "id": "pg050_n0001",
      "text": "Zoezi la 1"
    },
    {
      "id": "pg050_n0002",
      "text": "Oanisha kifaa na kazi yake."
    },
    {
      "id": "pg050_n0003",
      "text": "Onesha kwa kuchora mstari."
    },
    {
      "id": "pg050_n0004",
      "text": "kazi Jina la kifaa"
    },
    {
      "id": "pg050_n0005",
      "text": "Huondoa vumbi na uchafu"
    },
    {
      "id": "pg050_n0006",
      "text": "Hutumika kulimia"
    },
    {
      "id": "pg050_n0007",
      "text": "Hutumika kukusanya nyasi na takataka"
    },
    {
      "id": "pg050_n0008",
      "text": "Hutumika kuhifadhi takataka kabla ya"
    },
    {
      "id": "pg050_n0009",
      "text": "kuzitupa shimoni"
    },
    {
      "id": "pg050_n0010",
      "text": "Hutumika kukatia maua"
    },
    {
      "id": "pg050_n0011",
      "text": "Hubebea takataka baada ya kufagia"
    },
    {
      "id": "pg050_n0012",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg050_n0013",
      "text": "1."
    },
    {
      "id": "pg050_n0014",
      "text": "Safisha darasa kwa kutumia vifaa vya kufanyia usafi."
    },
    {
      "id": "pg050_n0015",
      "text": "2."
    },
    {
      "id": "pg050_n0016",
      "text": "Tumia vifaa vya usafi kusafisha mazingira ya shule."
    },
    {
      "id": "pg050_n0017",
      "text": "44"
    },
