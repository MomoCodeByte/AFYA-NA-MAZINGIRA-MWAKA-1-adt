  "transcript": [
    {
      "id": "pg027_n0001",
      "text": "3."
    },
    {
      "id": "pg027_n0002",
      "text": "Safisha mikunjo ya mbele ya sikio kwa kitambaa."
    },
    {
      "id": "pg027_n0003",
      "text": "4."
    },
    {
      "id": "pg027_n0004",
      "text": "Safisha sehemu ya nyuma ya sikio kwa kitambaa."
    },
    {
      "id": "pg027_n0005",
      "text": "5."
    },
    {
      "id": "pg027_n0006",
      "text": "Kausha masikio kwa kitambaa laini au taulo safi."
    },
    {
      "id": "pg027_n0007",
      "text": "6."
    },
    {
      "id": "pg027_n0008",
      "text": "Tumia kioo kukagua kama masikio yamekuwa safi."
    },
    {
      "id": "pg027_n0009",
      "text": "Vitendo vya kusafisha masikio"
    },
    {
      "id": "pg027_n0010",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg027_n0011",
      "text": "Safisha masikio kwa kufuata hatua"
    },
    {
      "id": "pg027_n0012",
      "text": "Zoezi la 2"
    },
    {
      "id": "pg027_n0013",
      "text": "1."
    },
    {
      "id": "pg027_n0014",
      "text": "Andika majina ya vifaa vinavyotumika kusafishia masikio."
    },
    {
      "id": "pg027_n0015",
      "text": "2."
    },
    {
      "id": "pg027_n0016",
      "text": "Taja sehemu za sikio zinazotakiwa kusafishwa."
    },
    {
      "id": "pg027_n0017",
      "text": "3."
    },
    {
      "id": "pg027_n0018",
      "text": "Masikio yakiuma tunashauriwa kufanya nini?"
    },
    {
      "id": "pg027_n0019",
      "text": "4."
    },
    {
      "id": "pg027_n0020",
      "text": "Kwa nini ni hatari kuingiza kitu kwenye masikio?"
    },
    {
      "id": "pg027_n0021",
      "text": "Usafi wa kucha"
    },
    {
      "id": "pg027_n0022",
      "text": "Kucha ni sehemu inayofunika ngozi laini ya kidole."
    },
    {
      "id": "pg027_n0023",
      "text": "Kucha"
    },
    {
      "id": "pg027_n0024",
      "text": "ndefu huhifadhi uchafu."
    },
    {
      "id": "pg027_n0025",
      "text": "Uchafu huficha vijidudu vya magonjwa"
    },
    {
      "id": "pg027_n0026",
      "text": "mbalimbali.Tukila chakula tukiwa na kucha chafu tutapata"
    },
    {
      "id": "pg027_n0027",
      "text": "magonjwa."
    },
    {
      "id": "pg027_n0028",
      "text": "Magonjwa hayo ni kipindupindu, kuumwa tumbo"
    },
    {
      "id": "pg027_n0029",
      "text": "na kuharisha."
    },
    {
      "id": "pg027_n0030",
      "text": "Tunatakiwa kukata kucha zetu ili tuepuke"
    },
    {
      "id": "pg027_n0031",
      "text": "magonjwa."
    },
    {
      "id": "pg027_n0032",
      "text": "Pia tusichangie vifaa vya kukatia kucha."
    },
    {
      "id": "pg027_n0033",
      "text": "Kuchangia"
    },
    {
      "id": "pg027_n0034",
      "text": "vifaa husababisha maambukizi ya Virusi vya UKIMWI."
    },
    {
      "id": "pg027_n0035",
      "text": "2211"
    },
    {
      "id": "pg027_n0036",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 21 23/07/2021 15:41"
    }
  ]
}