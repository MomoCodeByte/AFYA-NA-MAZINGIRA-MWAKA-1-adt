  "transcript": [
    {
      "id": "pg049_n0001",
      "text": "Mazingira ni vitu vyote vinavyotuzunguka kama vile hewa,"
    },
    {
      "id": "pg049_n0002",
      "text": "maji na mimea."
    },
    {
      "id": "pg049_n0003",
      "text": "Hivyo inatupasa kusafisha na kutunza"
    },
    {
      "id": "pg049_n0004",
      "text": "mazingira yetu ya nyumbani na shuleni."
    },
    {
      "id": "pg049_n0005",
      "text": "Mazingira safi huvutia"
    },
    {
      "id": "pg049_n0006",
      "text": "na kupendeza sana."
    },
    {
      "id": "pg049_n0007",
      "text": "Vilevile, huepusha wadudu na vijidudu"
    },
    {
      "id": "pg049_n0008",
      "text": "vya magonjwa."
    },
    {
      "id": "pg049_n0009",
      "text": "Hivyo, maisha ya viumbe yanahitaji uwepo wa"
    },
    {
      "id": "pg049_n0010",
      "text": "mazingira safi na salama."
    },
    {
      "id": "pg049_n0011",
      "text": "Tazama picha hii kisha jibu maswali"
    },
    {
      "id": "pg049_n0012",
      "text": "Maswali"
    },
    {
      "id": "pg049_n0013",
      "text": "1."
    },
    {
      "id": "pg049_n0014",
      "text": "Taja vifaa vingine vinavyotumika kusafisha mazingira."
    },
    {
      "id": "pg049_n0015",
      "text": "2."
    },
    {
      "id": "pg049_n0016",
      "text": "Ni wadudu gani wanaopatikana katika mazingira machafu?"
    },
    {
      "id": "pg049_n0017",
      "text": "3."
    },
    {
      "id": "pg049_n0018",
      "text": "Baada ya kuokota takataka unapaswa kufanya nini?"
    },
    {
      "id": "pg049_n0019",
      "text": "4."
    },
    {
      "id": "pg049_n0020",
      "text": "Mazingira yasiyo safi husababisha madhara gani?"
    },
    {
      "id": "pg049_n0021",
      "text": "5."
    },
    {
      "id": "pg049_n0022",
      "text": "Chora picha za vifaa vya usafi wa mazingira."
    },
    {
      "id": "pg049_n0023",
      "text": "4433"
    },
    {
      "id": "pg049_n0024",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 43 23/07/2021 15:41"
    }
  ]
}