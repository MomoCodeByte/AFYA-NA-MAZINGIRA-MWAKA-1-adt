  "transcript": [
    {
      "id": "pg010_n0001",
      "text": "Kutambua milio na sauti za vitu na wanyama mbalimbali"
    },
    {
      "id": "pg010_n0002",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg010_n0003",
      "text": "Mwambie rafiki yako aigize sauti na milio mbalimbali."
    },
    {
      "id": "pg010_n0004",
      "text": "Maswali"
    },
    {
      "id": "pg010_n0005",
      "text": "1."
    },
    {
      "id": "pg010_n0006",
      "text": "Je, rafiki yako ameigiza mlio au sauti ya nini?"
    },
    {
      "id": "pg010_n0007",
      "text": "2."
    },
    {
      "id": "pg010_n0008",
      "text": "Ulitumia kiungo gani kusikiliza mlio au sauti hiyo?"
    },
    {
      "id": "pg010_n0009",
      "text": "Vitu mbalimbali hutoa milio."
    },
    {
      "id": "pg010_n0010",
      "text": "Mfano, kengele, ngoma, zeze,"
    },
    {
      "id": "pg010_n0011",
      "text": "filimbi, debe na ubao."
    },
    {
      "id": "pg010_n0012",
      "text": "Sauti zinatolewa na viumbe hai."
    },
    {
      "id": "pg010_n0013",
      "text": "Mfano,"
    },
    {
      "id": "pg010_n0014",
      "text": "watu, wanyama, ndege na wadudu."
    },
    {
      "id": "pg010_n0015",
      "text": "Tunasikiliza sauti na milio mbalimbali kwa kutumia masikio."
    },
    {
      "id": "pg010_n0016",
      "text": "Wimbo wa sauti za wanyama mbalimbali"
    },
    {
      "id": "pg010_n0017",
      "text": "Nyauu, nyauu."
    },
    {
      "id": "pg010_n0018",
      "text": "Hii sauti ya nini?"
    },
    {
      "id": "pg010_n0019",
      "text": "Sauti ya paka."
    },
    {
      "id": "pg010_n0020",
      "text": "Paka, paka ni rafiki yetu anafukuza panya."
    },
    {
      "id": "pg010_n0021",
      "text": "Wu wu."
    },
    {
      "id": "pg010_n0022",
      "text": "Hii sauti ya nini?"
    },
    {
      "id": "pg010_n0023",
      "text": "Sauti ya mbwa."
    },
    {
      "id": "pg010_n0024",
      "text": "Mbwa, mbwa ni"
    },
    {
      "id": "pg010_n0025",
      "text": "rafiki yetu anatupa ulinzi."
    },
    {
      "id": "pg010_n0026",
      "text": "Mee, mee."
    },
    {
      "id": "pg010_n0027",
      "text": "Hii sauti ya nini?"
    },
    {
      "id": "pg010_n0028",
      "text": "Sauti ya mbuzi."
    },
    {
      "id": "pg010_n0029",
      "text": "Mbuzi, mbuzi ni"
    },
    {
      "id": "pg010_n0030",
      "text": "rafiki yetu anatupa nyama na maziwa."
    },
    {
      "id": "pg010_n0031",
      "text": "Moo, moo."
    },
    {
      "id": "pg010_n0032",
      "text": "Hii sauti ya nini?"
    },
    {
      "id": "pg010_n0033",
      "text": "Sauti ya ng’ombe."
    },
    {
      "id": "pg010_n0034",
      "text": "Ng’ombe,"
    },
    {
      "id": "pg010_n0035",
      "text": "ng’ombe ni rafiki yetu anatupa nyama na maziwa."
    },
    {
      "id": "pg010_n0036",
      "text": "Zoezi la 2"
    },
    {
      "id": "pg010_n0037",
      "text": "1."
    },
    {
      "id": "pg010_n0038",
      "text": "Je ni vitu gani ukivitumia vinatoa sauti?"
    },
    {
      "id": "pg010_n0039",
      "text": "2."
    },
    {
      "id": "pg010_n0040",
      "text": "Chora vitu vitatu vinavyotoa sauti."
    },
    {
      "id": "pg010_n0041",
      "text": "3."
    },
    {
      "id": "pg010_n0042",
      "text": "Taja majina ya wanyama unayoweza kuigiza sauti zao."
    },
    {
      "id": "pg010_n0043",
      "text": "4"
    },
    {
      "id": "pg010_n0044",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 4 23/07/2021 15:41"
    }
  ]
}