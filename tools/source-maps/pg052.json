  "transcript": [
    {
      "id": "pg052_n0001",
      "text": "3."
    },
    {
      "id": "pg052_n0002",
      "text": "Sambaza mbegu kwenye kitalu."
    },
    {
      "id": "pg052_n0003",
      "text": "4."
    },
    {
      "id": "pg052_n0004",
      "text": "Funika kitalu kwa nyasi kavu ili kuhifadhi unyevu."
    },
    {
      "id": "pg052_n0005",
      "text": "5."
    },
    {
      "id": "pg052_n0006",
      "text": "Mwagilia kila siku hadi miche itokeze."
    },
    {
      "id": "pg052_n0007",
      "text": "6."
    },
    {
      "id": "pg052_n0008",
      "text": "Ondoa nyasi miche ikitokeza."
    },
    {
      "id": "pg052_n0009",
      "text": "7."
    },
    {
      "id": "pg052_n0010",
      "text": "Ruhusu miche ipate hewa na mwanga wa jua."
    },
    {
      "id": "pg052_n0011",
      "text": "8."
    },
    {
      "id": "pg052_n0012",
      "text": "Andaa mashimo ya kupanda miche."
    },
    {
      "id": "pg052_n0013",
      "text": "9."
    },
    {
      "id": "pg052_n0014",
      "text": "Weka mbolea kwenye mashimo na mwagilia maji."
    },
    {
      "id": "pg052_n0015",
      "text": "10."
    },
    {
      "id": "pg052_n0016",
      "text": "Panda miche kwenye mashimo yaliyoandaliwa."
    },
    {
      "id": "pg052_n0017",
      "text": "46"
    },
    {
      "id": "pg052_n0018",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 46 23/07/2021 15:41"
    }
  ]
