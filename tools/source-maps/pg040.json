  "transcript": [
    {
      "id": "pg040_n0001",
      "text": "Vifaa vinavyotumika kusafishia vyombo vya chakula"
    },
    {
      "id": "pg040_n0002",
      "text": "kiosheo sabuni beseni"
    },
    {
      "id": "pg040_n0003",
      "text": "Hatua za kuosha vyombo vya chakula"
    },
    {
      "id": "pg040_n0004",
      "text": "1."
    },
    {
      "id": "pg040_n0005",
      "text": "Andaa vifaa vya kuoshea vyombo."
    },
    {
      "id": "pg040_n0006",
      "text": "2."
    },
    {
      "id": "pg040_n0007",
      "text": "Ondoa mabaki ya"
    },
    {
      "id": "pg040_n0008",
      "text": "chakula kwenye"
    },
    {
      "id": "pg040_n0009",
      "text": "vyombo."
    },
    {
      "id": "pg040_n0010",
      "text": "3."
    },
    {
      "id": "pg040_n0011",
      "text": "Tumia sabuni na"
    },
    {
      "id": "pg040_n0012",
      "text": "kiosheo kuosha chombo"
    },
    {
      "id": "pg040_n0013",
      "text": "kimojakimoja."
    },
    {
      "id": "pg040_n0014",
      "text": "4."
    },
    {
      "id": "pg040_n0015",
      "text": "Suuza vyombo kwenye maji safi."
    },
    {
      "id": "pg040_n0016",
      "text": "5."
    },
    {
      "id": "pg040_n0017",
      "text": "Kausha vyombo kwa kutumia kitamba safi."
    },
    {
      "id": "pg040_n0018",
      "text": "Kama huna"
    },
    {
      "id": "pg040_n0019",
      "text": "kitambaa anika vyombo kwenye kichanja."
    },
    {
      "id": "pg040_n0020",
      "text": "34"
    },
    {
      "id": "pg040_n0021",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 34 23/07/2021 15:41"
    }
  ]
}