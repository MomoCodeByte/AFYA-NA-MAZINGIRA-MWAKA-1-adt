  "transcript": [
    {
      "id": "pg053_n0001",
      "text": "11."
    },
    {
      "id": "pg053_n0002",
      "text": "Endelea kumwagilia mpaka miche ikue"
    },
    {
      "id": "pg053_n0003",
      "text": "Maswali"
    },
    {
      "id": "pg053_n0004",
      "text": "1."
    },
    {
      "id": "pg053_n0005",
      "text": "Kwa nini tunafunika kitalu baada ya kusia mbegu?"
    },
    {
      "id": "pg053_n0006",
      "text": "2."
    },
    {
      "id": "pg053_n0007",
      "text": "Zipo mbegu zinazopandwa moja kwa moja kwenye"
    },
    {
      "id": "pg053_n0008",
      "text": "mashimo."
    },
    {
      "id": "pg053_n0009",
      "text": "Taja majina matano ya mbegu hizo."
    },
    {
      "id": "pg053_n0010",
      "text": "3."
    },
    {
      "id": "pg053_n0011",
      "text": "Kwa nini tunamwagilia miche baada ya kupanda kwenye"
    },
    {
      "id": "pg053_n0012",
      "text": "shimo?"
    },
    {
      "id": "pg053_n0013",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg053_n0014",
      "text": "1."
    },
    {
      "id": "pg053_n0015",
      "text": "Sia mbegu kwenye kitalu kilichoandaliwa."
    },
    {
      "id": "pg053_n0016",
      "text": "2."
    },
    {
      "id": "pg053_n0017",
      "text": "Otesha mche mmoja shuleni kwa kufuata hatua."
    },
    {
      "id": "pg053_n0018",
      "text": "Vilevile,"
    },
    {
      "id": "pg053_n0019",
      "text": "otesha mche mwingine nyumbani kwa kufuata hatua."
    },
    {
      "id": "pg053_n0020",
      "text": "3."
    },
    {
      "id": "pg053_n0021",
      "text": "Mwagilia miche kila siku hadi ikue."
    },
    {
      "id": "pg053_n0022",
      "text": "4."
    },
    {
      "id": "pg053_n0023",
      "text": "Andika kwa ufupi ulichojifunza tangu umeotesha mti hadi"
    },
    {
      "id": "pg053_n0024",
      "text": "umekua kwa kuonesha changamoto na mafanikio."
    },
    {
      "id": "pg053_n0025",
      "text": "4477"
    },
    {
      "id": "pg053_n0026",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 47 23/07/2021 15:42"
    }
  ]
}