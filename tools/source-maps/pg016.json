  "transcript": [
    {
      "id": "pg016_n0001",
      "text": "Kutunza chakula kwa usalama"
    },
    {
      "id": "pg016_n0002",
      "text": "kawa ungo sahani kifaa cha"
    },
    {
      "id": "pg016_n0003",
      "text": "kuning'inizia"
    },
    {
      "id": "pg016_n0004",
      "text": "chakula"
    },
    {
      "id": "pg016_n0005",
      "text": "Chakula kinatakiwa kitunzwe kwa usafi na usalama."
    },
    {
      "id": "pg016_n0006",
      "text": "Chakula"
    },
    {
      "id": "pg016_n0007",
      "text": "kilichotunzwa vizuri hakiharibiwi na wadudu."
    },
    {
      "id": "pg016_n0008",
      "text": "Mfano wa wadudu"
    },
    {
      "id": "pg016_n0009",
      "text": "wanaoharibu chakula ni mende, nzi na sisimizi."
    },
    {
      "id": "pg016_n0010",
      "text": "Wadudu hawa"
    },
    {
      "id": "pg016_n0011",
      "text": "hueneza magonjwa kama kuharisha na kipindupindu."
    },
    {
      "id": "pg016_n0012",
      "text": "Wadudu"
    },
    {
      "id": "pg016_n0013",
      "text": "wanapotua kwenye chakula huacha vijidudu vya magonjwa."
    },
    {
      "id": "pg016_n0014",
      "text": "Ukila chakula hicho unaweza kupata magonjwa."
    },
    {
      "id": "pg016_n0015",
      "text": "Tunatunza"
    },
    {
      "id": "pg016_n0016",
      "text": "chakula ili kiwe salama."
    },
    {
      "id": "pg016_n0017",
      "text": "Chakula salama uwezesha mwili kuwa"
    },
    {
      "id": "pg016_n0018",
      "text": "na afya bora."
    },
    {
      "id": "pg016_n0019",
      "text": "Zifuatazo ni njia mbalimbali za kutunza chakula"
    },
    {
      "id": "pg016_n0020",
      "text": "Kabati la chakula Jokofu"
    },
    {
      "id": "pg016_n0021",
      "text": "10"
    },
    {
      "id": "pg016_n0022",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 10 23/07/2021 15:41"
    }
  ]
}