  "transcript": [
    {
      "id": "pg051_n0001",
      "text": "Kupanda mbegu na miche kwa kuzingatia kanuni"
    },
    {
      "id": "pg051_n0002",
      "text": "Miti na maua hupendezesha mazingira na kuyafanya yavutie."
    },
    {
      "id": "pg051_n0003",
      "text": "Miti husaidia kutunza mazingira yetu."
    },
    {
      "id": "pg051_n0004",
      "text": "Tunashauriwa kupanda"
    },
    {
      "id": "pg051_n0005",
      "text": "mbegu na miche."
    },
    {
      "id": "pg051_n0006",
      "text": "Tupande mbegu na miche tupate miti au"
    },
    {
      "id": "pg051_n0007",
      "text": "maua."
    },
    {
      "id": "pg051_n0008",
      "text": "Kuna kanuni mbalimbali za kupanda mbegu au miche."
    },
    {
      "id": "pg051_n0009",
      "text": "Zipo mbegu zinazopandwa moja kwa moja kwenye mashimo."
    },
    {
      "id": "pg051_n0010",
      "text": "Mfano wa mbegu hizo ni mahindi, maharage na baadhi ya"
    },
    {
      "id": "pg051_n0011",
      "text": "zile za miti."
    },
    {
      "id": "pg051_n0012",
      "text": "Mbegu nyingine ni lazima kuziotesha ili zitoe"
    },
    {
      "id": "pg051_n0013",
      "text": "miche."
    },
    {
      "id": "pg051_n0014",
      "text": "Kusia ni kumwaga mbegu kwenye kitalu."
    },
    {
      "id": "pg051_n0015",
      "text": "Kitalu ni eneo"
    },
    {
      "id": "pg051_n0016",
      "text": "lililoandaliwa ili kuotesha mbegu."
    },
    {
      "id": "pg051_n0017",
      "text": "Mfano wa mbegu hizo ni"
    },
    {
      "id": "pg051_n0018",
      "text": "nyanya, spinachi, mpunga na vitunguu."
    },
    {
      "id": "pg051_n0019",
      "text": "Kanuni za upandaji wa mbegu"
    },
    {
      "id": "pg051_n0020",
      "text": "1."
    },
    {
      "id": "pg051_n0021",
      "text": "Andaa kitalu kwa kutifua na kuweka mbolea."
    },
    {
      "id": "pg051_n0022",
      "text": "2."
    },
    {
      "id": "pg051_n0023",
      "text": "Mwagilia kitalu ili udongo uwe na unyevu."
    },
    {
      "id": "pg051_n0024",
      "text": "4455"
    },
    {
      "id": "pg051_n0025",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 45 23/07/2021 15:41"
    }
  ]
