    {
      "id": "pg013_n0001",
      "text": "Zoezi la 4"
    },
    {
      "id": "pg013_n0002",
      "text": "Jibu maswali haya"
    },
    {
      "id": "pg013_n0003",
      "text": "Oanisha sehemu ya mwili na kazi yake."
    },
    {
      "id": "pg013_n0004",
      "text": "Chora mistari kama"
    },
    {
      "id": "pg013_n0005",
      "text": "ilivyooneshwa."
    },
    {
      "id": "pg013_n0006",
      "text": "Mfano Sikio – kusikia"
    },
    {
      "id": "pg013_n0007",
      "text": "Sehemu za mwili Kazi zake"
    },
    {
      "id": "pg013_n0008",
      "text": "kushika vitu"
    },
    {
      "id": "pg013_n0009",
      "text": "kutembea"
    },
    {
      "id": "pg013_n0010",
      "text": "kunusa"
    },
    {
      "id": "pg013_n0011",
      "text": "kusikia"
    },
    {
      "id": "pg013_n0012",
      "text": "kuongea na kula"
    },
    {
      "id": "pg013_n0013",
      "text": "kuona"
    },
    {
      "id": "pg013_n0014",
      "text": "Ili mwili uweze kukua vizuri unahitaji uwe na afya bora."
    },
    {
      "id": "pg013_n0015",
      "text": "Katika"
    },
    {
      "id": "pg013_n0016",
      "text": "sura ya pili utajifunza kuhusu afya bora katika mwili wa"
    },
    {
      "id": "pg013_n0017",
      "text": "binadamu."
