    {
      "id": "pg008_n0001",
      "text": "Sehemu za nje za mwili wa binadamu"
    },
    {
      "id": "pg008_n0002",
      "text": "Angalia picha hii, kisha jibu swali."
    },
    {
      "id": "pg008_n0003",
      "text": "Taja sehemu za nje za mwili wa binadamu"
    },
    {
      "id": "pg008_n0004",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg008_n0005",
      "text": "Chora mwili wa binadamu na uoneshe sehemu za nje za mwili"
    },
    {
