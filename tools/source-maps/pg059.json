  "transcript": [
    {
      "id": "pg059_n0001",
      "text": "Alama ya taa za Alama ya watembea"
    },
    {
      "id": "pg059_n0002",
      "text": "barabarani kwa miguu"
    },
    {
      "id": "pg059_n0003",
      "text": "Alama ya njia ya"
    },
    {
      "id": "pg059_n0004",
      "text": "Alama ya kivuko cha"
    },
    {
      "id": "pg059_n0005",
      "text": "wa nafunzi waendesha baiskeli"
    },
    {
      "id": "pg059_n0006",
      "text": "Jibu maswali yafuatayo"
    },
    {
      "id": "pg059_n0007",
      "text": "1."
    },
    {
      "id": "pg059_n0008",
      "text": "Taja alama za tahadhari zinazopatikana shuleni au"
    },
    {
      "id": "pg059_n0009",
      "text": "nyumbani."
    },
    {
      "id": "pg059_n0010",
      "text": "2."
    },
    {
      "id": "pg059_n0011",
      "text": "Ni alama gani za tahadhari zinazotumika barabarani?"
    },
    {
      "id": "pg059_n0012",
      "text": "3."
    },
    {
      "id": "pg059_n0013",
      "text": "Alama ifuatayo inakupa tahadhari gani?"
    },
    {
      "id": "pg059_n0014",
      "text": "5533"
    },
    {
      "id": "pg059_n0015",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 53 23/07/2021 15:42"
