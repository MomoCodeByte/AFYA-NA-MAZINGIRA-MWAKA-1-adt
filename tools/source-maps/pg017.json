  "transcript": [
    {
      "id": "pg017_n0001",
      "text": "Kufunika chakula kwa ungo, kawa au sahani."
    },
    {
      "id": "pg017_n0002",
      "text": "Kifaa maalumu cha kutunzia chakula kwa kuning'iniza"
    },
    {
      "id": "pg017_n0003",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg017_n0004",
      "text": "1."
    },
    {
      "id": "pg017_n0005",
      "text": "Andika vifaa mnavyotumia nyumbani kwenu kutunzia"
    },
    {
      "id": "pg017_n0006",
      "text": "chakula."
    },
    {
      "id": "pg017_n0007",
      "text": "2."
    },
    {
      "id": "pg017_n0008",
      "text": "Chora vifaa hivyo."
    },
    {
      "id": "pg017_n0009",
      "text": "Zoezi la 2"
    },
    {
      "id": "pg017_n0010",
      "text": "1."
    },
    {
      "id": "pg017_n0011",
      "text": "Orodhesha mifano miwili ya magonjwa yanayotokana na"
    },
    {
      "id": "pg017_n0012",
      "text": "kula chakula kisichotunzwa vizuri."
    },
    {
      "id": "pg017_n0013",
      "text": "2."
    },
    {
      "id": "pg017_n0014",
      "text": "Taja mifano mitatu ya wadudu wanaoleta vijidudu vya"
    },
    {
      "id": "pg017_n0015",
      "text": "maradhi kwenye chakula."
    },
    {
      "id": "pg017_n0016",
      "text": "1111"
    },
    {
