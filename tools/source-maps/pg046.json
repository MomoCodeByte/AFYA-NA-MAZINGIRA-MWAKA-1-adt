  "transcript": [
    {
      "id": "pg046_n0001",
      "text": "Kisha mwalimu alitaja njia za kujikinga na maambukizi ya"
    },
    {
      "id": "pg046_n0002",
      "text": "VVU."
    },
    {
      "id": "pg046_n0003",
      "text": "1."
    },
    {
      "id": "pg046_n0004",
      "text": "Epuka kuchangia sindano unapopatiwa matibabu."
    },
    {
      "id": "pg046_n0005",
      "text": "2."
    },
    {
      "id": "pg046_n0006",
      "text": "Epuka kuchangia sindano unapotoga masikio."
    },
    {
      "id": "pg046_n0007",
      "text": "3."
    },
    {
      "id": "pg046_n0008",
      "text": "Funga vidonda wakati wote ili visitoe damu."
    },
    {
      "id": "pg046_n0009",
      "text": "4."
    },
    {
      "id": "pg046_n0010",
      "text": "Epuka kugusa damu ya mtu mwingine."
    },
    {
      "id": "pg046_n0011",
      "text": "5."
    },
    {
      "id": "pg046_n0012",
      "text": "Vaa glovu au mfuko wa plastiki unapomhudumia majeruhi."
    },
    {
      "id": "pg046_n0013",
      "text": "6."
    },
    {
      "id": "pg046_n0014",
      "text": "Epuka kuchangia vifaa kama miswaki, dodoki na vitana."
    },
    {
      "id": "pg046_n0015",
      "text": "Wimbo"
    },
    {
      "id": "pg046_n0016",
      "text": "VVU ni Virusi vya Ukimwi x 2"
    },
    {
      "id": "pg046_n0017",
      "text": "UKIMWI ni nini jamani?"
    },
    {
      "id": "pg046_n0018",
      "text": "UKIMWI ni Upungufu wa Kinga Mwilini jamani x 2"
    },
    {
      "id": "pg046_n0019",
      "text": "Tusichangie wembe, sindano na mswaki x 2"
    },
    {
      "id": "pg046_n0020",
      "text": "Tusichangie chanuo, kitana na pini x 2"
    },
    {
      "id": "pg046_n0021",
      "text": "Tukichangia hivyo tutapata UKIMWI ×2"
    },
    {
      "id": "pg046_n0022",
      "text": "Maswali"
    },
    {
      "id": "pg046_n0023",
      "text": "1."
    },
    {
      "id": "pg046_n0024",
      "text": "Ili kutambua kuwa umeambukizwa VVU unapaswa kufanya"
    },
    {
      "id": "pg046_n0025",
      "text": "nini?"
    },
    {
      "id": "pg046_n0026",
      "text": "2."
    },
    {
      "id": "pg046_n0027",
      "text": "Orodhesha vitu vitano ambavyo vikichangiwa husababisha"
    },
    {
      "id": "pg046_n0028",
      "text": "maambukizi ya VVU."
    },
    {
      "id": "pg046_n0029",
      "text": "3."
    },
    {
      "id": "pg046_n0030",
      "text": "Andika njia tano za kujikinga na maambukizi ya VVU."
    },
    {
      "id": "pg046_n0031",
      "text": "4."
    },
    {
      "id": "pg046_n0032",
      "text": "Nini hatari ya kugusa damu ya mtu mwenye VVU?"
    },
    {
      "id": "pg046_n0033",
      "text": "40"
    },
    {
      "id": "pg046_n0034",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 40 23/07/2021 15:41"
    }
  ]
}