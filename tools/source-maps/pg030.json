  "transcript": [
    {
      "id": "pg030_n0001",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg030_n0002",
      "text": "Fuata hatua za kukata kucha."
    },
    {
      "id": "pg030_n0003",
      "text": "Kata kucha kwa kutumia"
    },
    {
      "id": "pg030_n0004",
      "text": "mojawapo ya vifaa hivi."
    },
    {
      "id": "pg030_n0005",
      "text": "1."
    },
    {
      "id": "pg030_n0006",
      "text": "Wembe"
    },
    {
      "id": "pg030_n0007",
      "text": "2."
    },
    {
      "id": "pg030_n0008",
      "text": "Mkasi"
    },
    {
      "id": "pg030_n0009",
      "text": "3."
    },
    {
      "id": "pg030_n0010",
      "text": "Kikata kucha"
    },
    {
      "id": "pg030_n0011",
      "text": "Zoezi la 3"
    },
    {
      "id": "pg030_n0012",
      "text": "1."
    },
    {
      "id": "pg030_n0013",
      "text": "Taja vifaa vinavyotumika kukatia kucha."
    },
    {
      "id": "pg030_n0014",
      "text": "2."
    },
    {
      "id": "pg030_n0015",
      "text": "Kucha ndefu zinahifadhi nini?"
    },
    {
      "id": "pg030_n0016",
      "text": "3."
    },
    {
      "id": "pg030_n0017",
      "text": "Ukichangia vifaa vya kukatia kucha utapata madhara"
    },
    {
      "id": "pg030_n0018",
      "text": "gani?"
    },
    {
      "id": "pg030_n0019",
      "text": "4."
    },
    {
      "id": "pg030_n0020",
      "text": "Kwa nini tunakata kucha?"
    },
    {
      "id": "pg030_n0021",
      "text": "Kutunza nywele"
    },
    {
      "id": "pg030_n0022",
      "text": "Angalia picha zifuatazo, kisha jibu maswali."
    },
    {
      "id": "pg030_n0023",
      "text": "1 2"
    },
    {
      "id": "pg030_n0024",
      "text": "1."
    },
    {
      "id": "pg030_n0025",
      "text": "Taja tofauti ya picha namba 1 na 2."
    },
    {
      "id": "pg030_n0026",
      "text": "2."
    },
    {
      "id": "pg030_n0027",
      "text": "Picha gani inakuvutia?"
    },
    {
      "id": "pg030_n0028",
      "text": "Kwa nini?"
    },
    {
      "id": "pg030_n0029",
      "text": "3."
    },
    {
      "id": "pg030_n0030",
      "text": "Picha ya mtoto yupi inayofaa kuigwa?"
    },
    {
      "id": "pg030_n0031",
      "text": "24"
    },
