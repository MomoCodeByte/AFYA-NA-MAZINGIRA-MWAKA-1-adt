  "transcript": [
    {
      "id": "pg009_n0001",
      "text": "Kazi za sehemu za nje za mwili wa binadamu"
    },
    {
      "id": "pg009_n0002",
      "text": "Kiungo gani cha mwili kinatumika kuona vitu mbalimbali?"
    },
    {
      "id": "pg009_n0008",
      "text": "Zoezi la 1"
    },
    {
      "id": "pg009_n0009",
      "text": "Taja rangi za maumbo uliyoyaona"
    },
    {
      "id": "pg009_n0010",
      "text": "(a) Umbo namba 1 lina rangi................................"
    },
    {
      "id": "pg009_n0011",
      "text": "(b) Umbo namba 2 lina rangi................................"
    },
    {
      "id": "pg009_n0012",
