    },
    {
      "id": "pg009_n0013",
      "text": "(d) Umbo namba 4 lina rangi................................"
    },
    {
      "id": "pg009_n0014",
      "text": "(e) Umbo namba 5 lina rangi................................"
    },
    {
      "id": "pg009_n0015",
      "text": "Macho humwezesha binadamu kuona."
