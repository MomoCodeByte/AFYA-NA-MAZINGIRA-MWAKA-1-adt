  "transcript": [
    {
      "id": "pg056_n0001",
      "text": "Zoezi la 2"
    },
    {
      "id": "pg056_n0002",
      "text": "1."
    },
    {
      "id": "pg056_n0003",
      "text": "Taja vitendo hatarishi katika mazingira yako."
    },
    {
      "id": "pg056_n0004",
      "text": "2."
    },
    {
      "id": "pg056_n0005",
      "text": "Unawezaje kujiepusha na mazingira hatarishi?"
    },
    {
      "id": "pg056_n0006",
      "text": "3."
    },
    {
      "id": "pg056_n0007",
      "text": "Utafanya nini ukimuona rafiki yako anacheza barabarani?"
    },
    {
      "id": "pg056_n0008",
      "text": "4."
    },
    {
      "id": "pg056_n0009",
      "text": "Ukiogelea kwenye maji marefu utapata madhara gani?"
    },
    {
      "id": "pg056_n0010",
      "text": "5."
    },
    {
      "id": "pg056_n0011",
      "text": "Kati ya matendo yafuatayo ni yapi hatarishi?"
    },
    {
      "id": "pg056_n0012",
      "text": "a) Kupanda juu ya miti mirefu."
    },
    {
      "id": "pg056_n0013",
      "text": "b) Kusaidia kazi za nyumbani."
    },
    {
      "id": "pg056_n0014",
      "text": "c) Kucheza sehemu zenye giza."
    },
    {
      "id": "pg056_n0015",
      "text": "d) Kufagia uwanja."
    },
    {
      "id": "pg056_n0016",
      "text": "e) Kuchezea wembe au kisu na vitu vyenye ncha kali."
    },
    {
      "id": "pg056_n0017",
      "text": "6."
    },
    {
      "id": "pg056_n0018",
      "text": "Andika tabia hatarishi unazozifahamu."
    },
    {
      "id": "pg056_n0019",
      "text": "Viumbe hatarishi katika mazingira"
    },
    {
      "id": "pg056_n0020",
      "text": "Vipo viumbe mbalimbali hatarishi katika mazingira yetu."
    },
    {
      "id": "pg056_n0021",
      "text": "Viumbe hivyo ni kama vile nyoka, nyuki na mbu."
    },
    {
      "id": "pg056_n0022",
      "text": "Wengine ni"
    },
    {
      "id": "pg056_n0023",
      "text": "tandu, simba, chatu, chui na fisi."
    },
    {
      "id": "pg056_n0024",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg056_n0025",
      "text": "Kujigamba"
    },
    {
      "id": "pg056_n0026",
      "text": "Mimi ni Swila."
    },
    {
      "id": "pg056_n0027",
      "text": "Nina sumu"
    },
    {
      "id": "pg056_n0028",
      "text": "Mimi ni chatu."
    },
    {
      "id": "pg056_n0029",
      "text": "Nina uwezo"
    },
    {
      "id": "pg056_n0030",
      "text": "kali ikikupata itakuua."
    },
    {
      "id": "pg056_n0031",
      "text": "wa kumeza binadamu."
    },
    {
      "id": "pg056_n0032",
      "text": "50"
    },
    {
