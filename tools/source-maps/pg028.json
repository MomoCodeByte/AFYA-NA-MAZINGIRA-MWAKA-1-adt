  "transcript": [
    {
      "id": "pg028_n0001",
      "text": "Vifaa vinavyotumika kusafishia kucha"
    },
    {
      "id": "pg028_n0002",
      "text": "wembe"
    },
    {
      "id": "pg028_n0003",
      "text": "kikata kucha"
    },
    {
      "id": "pg028_n0004",
      "text": "sabuni"
    },
    {
      "id": "pg028_n0005",
      "text": "brashi"
    },
    {
      "id": "pg028_n0006",
      "text": "mkasi beseni taulo"
    },
    {
      "id": "pg028_n0007",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg028_n0008",
      "text": "Mshirikishe mwenzako namna unavyosafisha kucha."
    },
    {
      "id": "pg028_n0009",
      "text": "Namna ya kukata kucha"
    },
    {
      "id": "pg028_n0010",
      "text": "1."
    },
    {
      "id": "pg028_n0011",
      "text": "Chukua kifaa safi na salama cha kukatia kucha."
    },
    {
      "id": "pg028_n0012",
      "text": "2."
    },
    {
      "id": "pg028_n0013",
      "text": "Kata kucha ya kidole kimoja kimoja."
    },
    {
      "id": "pg028_n0014",
      "text": "3."
    },
    {
      "id": "pg028_n0015",
      "text": "Safisha vifaa ulivyokatia kucha."
    },
    {
      "id": "pg028_n0016",
      "text": "4."
    },
    {
      "id": "pg028_n0017",
      "text": "Safisha kucha za mikono na miguu."
    },
    {
      "id": "pg028_n0018",
      "text": "5."
    },
    {
      "id": "pg028_n0019",
      "text": "Tumia brashi, maji na sabuni kusafishia kucha."
    },
    {
      "id": "pg028_n0020",
      "text": "6."
    },
    {
      "id": "pg028_n0021",
      "text": "Kausha kwa kutumia kitambaa au taulo safi."
    },
    {
      "id": "pg028_n0022",
      "text": "22"
    },
    {
      "id": "pg028_n0023",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 22 23/07/2021 15:41"
    }
  ]
