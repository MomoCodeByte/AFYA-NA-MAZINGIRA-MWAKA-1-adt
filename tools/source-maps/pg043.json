  "transcript": [
    {
      "id": "pg043_n0001",
      "text": "1."
    },
    {
      "id": "pg043_n0002",
      "text": "Funua mfuniko wa shimo la choo kabla hujakitumia."
    },
    {
      "id": "pg043_n0003",
      "text": "2."
    },
    {
      "id": "pg043_n0004",
      "text": "Tumia choo kwa usahihi kwa kulenga shimo."
    },
    {
      "id": "pg043_n0005",
      "text": "3."
    },
    {
      "id": "pg043_n0006",
      "text": "Jisafishe kwa kutumia maji safi baada ya kujisaidia."
    },
    {
      "id": "pg043_n0007",
      "text": "Vilevile, unaweza kujipangusa kwa kutumia karatasi laini."
    },
    {
      "id": "pg043_n0008",
      "text": "4."
    },
    {
      "id": "pg043_n0009",
      "text": "Funika shimo la choo vizuri baada ya kujisaidia."
    },
    {
      "id": "pg043_n0010",
      "text": "5."
    },
    {
      "id": "pg043_n0011",
      "text": "Nawa vizuri mikono kwa maji safi na sabuni."
    },
    {
      "id": "pg043_n0012",
      "text": "3377"
    },
    {
