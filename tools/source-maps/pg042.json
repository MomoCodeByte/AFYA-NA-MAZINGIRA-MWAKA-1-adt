  "transcript": [
    {
      "id": "pg042_n0001",
      "text": "Matumizi sahihi ya choo"
    },
    {
      "id": "pg042_n0002",
      "text": "Picha ya mtoto yupi anatumia choo kwa usahihi?"
    },
    {
      "id": "pg042_n0003",
      "text": "1 2"
    },
    {
      "id": "pg042_n0004",
      "text": "Choo ni muhimu kwa matumizi ya binadamu."
    },
    {
      "id": "pg042_n0005",
      "text": "Choo kitumike"
    },
    {
      "id": "pg042_n0006",
      "text": "kwa usahihi ili kuepuka magonjwa."
    },
    {
      "id": "pg042_n0007",
      "text": "Magonjwa hayo ni kama"
    },
    {
      "id": "pg042_n0008",
      "text": "vile kipindupindu, kuhara na minyoo."
    },
    {
      "id": "pg042_n0009",
      "text": "Pia choo bora husaidia"
    },
    {
      "id": "pg042_n0010",
      "text": "kuhifadhi mazingira na vyanzo vya maji."
    },
    {
      "id": "pg042_n0011",
      "text": "Kuna aina mbalimbali"
    },
    {
      "id": "pg042_n0012",
      "text": "za vyoo."
    },
    {
      "id": "pg042_n0013",
      "text": "Mfano kuna vyoo vya shimo na vya kuvuta."
    },
    {
      "id": "pg042_n0014",
      "text": "Vyoo"
    },
    {
      "id": "pg042_n0015",
      "text": "vya kuvuta hutiririsha maji yanayoondosha kinyesi."
    },
    {
      "id": "pg042_n0016",
      "text": "Hatua sahihi za matumizi ya choo"
    },
    {
      "id": "pg042_n0017",
      "text": "36"
    },
    {
      "id": "pg042_n0018",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 36 23/07/2021 15:41"
    }
  ]
}