  "transcript": [
    {
      "id": "pg044_n0001",
      "text": "Kusafisha choo"
    },
    {
      "id": "pg044_n0002",
      "text": "Kwa nini tusafishe choo?"
    },
    {
      "id": "pg044_n0003",
      "text": "Tunasafisha choo kuepuka magonjwa"
    },
    {
      "id": "pg044_n0004",
      "text": "kama kuharisha na kipindupindu."
    },
    {
      "id": "pg044_n0005",
      "text": "Pia kuondoa harufu mbaya."
    },
    {
      "id": "pg044_n0006",
      "text": "Choo kisafishwe kwa maji, sabuni na dawa."
    },
    {
      "id": "pg044_n0007",
      "text": "Baada ya kusafisha"
    },
    {
      "id": "pg044_n0008",
      "text": "choo tunawe mikono."
    },
    {
      "id": "pg044_n0009",
      "text": "Tutumie maji safi na sabuni."
    },
    {
      "id": "pg044_n0010",
      "text": "Zoezi la 11"
    },
    {
      "id": "pg044_n0011",
      "text": "1."
    },
    {
      "id": "pg044_n0012",
      "text": "Andika vifaa vitatu vinavyotumika kusafisha choo."
    },
    {
      "id": "pg044_n0013",
      "text": "2."
    },
    {
      "id": "pg044_n0014",
      "text": "Taja wadudu wanaopenda kuishi chooni."
    },
    {
      "id": "pg044_n0015",
      "text": "3."
    },
    {
      "id": "pg044_n0016",
      "text": "Taja aina za vyoo unavyovifahamu."
    },
    {
      "id": "pg044_n0017",
      "text": "4."
    },
    {
      "id": "pg044_n0018",
      "text": "Andika magonjwa mawili utakayopata ukitumia choo"
    },
    {
      "id": "pg044_n0019",
      "text": "kichafu."
    },
    {
      "id": "pg044_n0020",
      "text": "5."
    },
    {
      "id": "pg044_n0021",
      "text": "Choo kinachotumika shuleni kwenu ni cha aina gani?"
    },
    {
      "id": "pg044_n0022",
      "text": "6."
    },
    {
      "id": "pg044_n0023",
      "text": "Eleza umuhimu wa kujisafisha baada ya kujisaidia."
    },
    {
      "id": "pg044_n0024",
      "text": "38"
    },
    {
      "id": "pg044_n0025",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 38 23/07/2021 15:41"
    }
  ]
}