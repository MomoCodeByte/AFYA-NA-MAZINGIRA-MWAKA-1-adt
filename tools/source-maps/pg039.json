  "transcript": [
    {
      "id": "pg039_n0001",
      "text": "Zoezi la 8"
    },
    {
      "id": "pg039_n0002",
      "text": "Panga sentensi kwa mtiririko wa matukio katika picha."
    },
    {
      "id": "pg039_n0003",
      "text": "1."
    },
    {
      "id": "pg039_n0004",
      "text": "Mtoto anatundika nguo baada ya kuzinyoosha."
    },
    {
      "id": "pg039_n0005",
      "text": "2."
    },
    {
      "id": "pg039_n0006",
      "text": "Mtoto anaandaa pasi tayari kwa kunyoosha nguo."
    },
    {
      "id": "pg039_n0007",
      "text": "3."
    },
    {
      "id": "pg039_n0008",
      "text": "Mtoto anaandaa meza kwa kutandika shuka."
    },
    {
      "id": "pg039_n0009",
      "text": "4."
    },
    {
      "id": "pg039_n0010",
      "text": "Mtoto anapiga nguo pasi."
    },
    {
      "id": "pg039_n0011",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg039_n0012",
      "text": "Fanya zoezi la kupiga pasi kwa kushirikiana na wenzako."
    },
    {
      "id": "pg039_n0013",
      "text": "Zoezi la 9"
    },
    {
      "id": "pg039_n0014",
      "text": "Jaza nafasi zilizoachwa wazi kwa kuchagua maneno"
    },
    {
      "id": "pg039_n0015",
      "text": "haya."
    },
    {
      "id": "pg039_n0016",
      "text": "Meza, zisipate unyevu, vijidudu, nadhifu, shuka, chafu, kabati."
    },
    {
      "id": "pg039_n0017",
      "text": "1."
    },
    {
      "id": "pg039_n0018",
      "text": "Joto la pasi huua..............."
    },
    {
      "id": "pg039_n0019",
      "text": "2."
    },
    {
      "id": "pg039_n0020",
      "text": "Unapopiga nguo pasi unatumia pasi, ........."
    },
    {
      "id": "pg039_n0021",
      "text": "na..........."
    },
    {
      "id": "pg039_n0022",
      "text": "3."
    },
    {
      "id": "pg039_n0023",
      "text": "Tunatundika nguo baada ya kupiga pasi ili.........."
    },
    {
      "id": "pg039_n0024",
      "text": "4."
    },
    {
      "id": "pg039_n0025",
      "text": "Tunahifadhi nguo iliyonyooshwa kwenye.............."
    },
    {
      "id": "pg039_n0026",
      "text": "Usafi wa vyombo vya chakula"
    },
    {
      "id": "pg039_n0027",
      "text": "Vyombo vya chakula ni lazima visafishwe kwa usahihi."
    },
    {
      "id": "pg039_n0028",
      "text": "Visafishwe kwa kutumia maji safi na sabuni."
    },
    {
      "id": "pg039_n0029",
      "text": "Vikaushwe"
    },
    {
      "id": "pg039_n0030",
      "text": "kwa kitambaa safi au vianikwe kwenye kichanja."
    },
    {
      "id": "pg039_n0031",
      "text": "Vyombo"
    },
    {
      "id": "pg039_n0032",
      "text": "visikae kwenye kichanja kwa muda mrefu."
    },
    {
      "id": "pg039_n0033",
      "text": "Hii husaidia vumbi"
    },
    {
      "id": "pg039_n0034",
      "text": "lisichafue vyombo."
    },
    {
      "id": "pg039_n0035",
      "text": "Pia husaidia kuvikinga visipate vijidudu"
    },
    {
      "id": "pg039_n0036",
      "text": "vya magonjwa."
    },
    {
      "id": "pg039_n0037",
      "text": "Vumbi na vijidudu vya magonjwa huvichafua."
    },
    {
      "id": "pg039_n0038",
      "text": "Vyombo vichafu huvutia wadudu waenezao magonjwa."
    },
    {
      "id": "pg039_n0039",
      "text": "Nzi,"
    },
    {
      "id": "pg039_n0040",
      "text": "sisimizi na mende hubeba vijidudu vya magonjwa."
    },
    {
      "id": "pg039_n0041",
      "text": "Magonjwa"
    },
    {
      "id": "pg039_n0042",
      "text": "hayo ni kuharisha, kuumwa tumbo na kipindupindu."
    },
    {
      "id": "pg039_n0043",
      "text": "3333"
    },
    {
      "id": "pg039_n0044",
      "text": "AFYA NA MAZINGIRA MWAKA 1.indd 33 23/07/2021 15:41"
    }
