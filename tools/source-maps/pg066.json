  "transcript": [
    {
      "id": "pg066_n0001",
      "text": "Sura ya Sita"
    },
    {
      "id": "pg066_n0002",
      "text": "Huduma ya kwanza"
    },
    {
      "id": "pg066_n0003",
      "text": "Utangulizi"
    },
    {
      "id": "pg066_n0004",
      "text": "Katika sura hii utajifunza kuhusu huduma ya kwanza."
    },
    {
      "id": "pg066_n0005",
      "text": "Utaweza kubaini vifaa vilivyomo ndani ya sanduku la huduma"
    },
    {
      "id": "pg066_n0006",
      "text": "ya kwanza.Vilevile utaweza kubaini ajali zinazotokea katika"
    },
    {
      "id": "pg066_n0007",
      "text": "mazingira yako na namna ya kutoa taarifa ajali inapotokea."
    },
    {
      "id": "pg066_n0008",
      "text": "Wimbo"
    },
    {
      "id": "pg066_n0009",
      "text": "Huduma ya kwanza x 2"
    },
    {
      "id": "pg066_n0010",
      "text": "Ni msaada"
    },
    {
      "id": "pg066_n0011",
      "text": "Huduma ya kwanza x 2"
    },
    {
      "id": "pg066_n0012",
      "text": "Ni msaada"
    },
    {
      "id": "pg066_n0013",
      "text": "Unaotolewa x 2"
    },
    {
      "id": "pg066_n0014",
      "text": "Ni msaada"
    },
    {
      "id": "pg066_n0015",
      "text": "Kwa mgonjwa x 2"
    },
    {
      "id": "pg066_n0016",
      "text": "Ni msaada"
    },
    {
      "id": "pg066_n0017",
      "text": "Kabla ya kwenda hospitalini x 2"
    },
    {
      "id": "pg066_n0018",
      "text": "Ni msaadaaaaa"
