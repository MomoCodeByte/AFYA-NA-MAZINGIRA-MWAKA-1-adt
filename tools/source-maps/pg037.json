  "transcript": [
    {
      "id": "pg037_n0001",
      "text": "Zoezi la 7"
    },
    {
      "id": "pg037_n0002",
      "text": "1."
    },
    {
      "id": "pg037_n0003",
      "text": "Andika sababu tatu za kufua nguo."
    },
    {
      "id": "pg037_n0004",
      "text": "2."
    },
    {
      "id": "pg037_n0005",
      "text": "Taja vifaa vinne vinavyotumika wakati wa kufua nguo."
    },
    {
      "id": "pg037_n0006",
      "text": "3."
    },
    {
      "id": "pg037_n0007",
      "text": "Taja sababu za kutenganisha nguo wakati wa kufua."
    },
    {
      "id": "pg037_n0008",
      "text": "4."
    },
    {
      "id": "pg037_n0009",
      "text": "Kwa nini tunatumia sabuni wakati wa kufua nguo?"
    },
    {
      "id": "pg037_n0010",
      "text": "Kupiga nguo pasi"
    },
    {
      "id": "pg037_n0011",
      "text": "Tunapiga nguo pasi ili zinyooke na kuuwa vijidudu."
    },
    {
      "id": "pg037_n0012",
      "text": "Vijidudu"
    },
    {
      "id": "pg037_n0013",
      "text": "vinaweza kusababisha magonjwa mbalimbali."
    },
    {
      "id": "pg037_n0014",
      "text": "Magonjwa hayo"
    },
    {
      "id": "pg037_n0015",
      "text": "ni kama vile upele na miwasho."
    },
    {
      "id": "pg037_n0016",
      "text": "Baada ya kunyoosha nguo,"
    },
    {
      "id": "pg037_n0017",
      "text": "tunazitundika zipate hewa."
    },
    {
      "id": "pg037_n0018",
      "text": "Hewa huondoa joto la pasi."
    },
    {
      "id": "pg037_n0019",
      "text": "Joto la"
    },
    {
      "id": "pg037_n0020",
      "text": "pasi husababisha unyevu."
    },
    {
      "id": "pg037_n0021",
