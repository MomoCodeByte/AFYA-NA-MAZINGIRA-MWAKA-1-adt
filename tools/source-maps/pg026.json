    },
    {
      "id": "pg026_n0013",
      "text": "Tunasafisha masikio kwenye mikunjo ya mbele na nyuma."
    },
    {
      "id": "pg026_n0014",
      "text": "Tunasafisha masikio ili kuua vijidudu vinavyoweza kusababisha"
    },
    {
      "id": "pg026_n0015",
      "text": "magonjwa na kuyaweka yawe safi."
    },
    {
      "id": "pg026_n0016",
      "text": "Ni hatari kuingiza kitu"
    },
    {
      "id": "pg026_n0017",
      "text": "chochote ndani ya sikio."
    },
    {
      "id": "pg026_n0018",
      "text": "Sikio likiuma tunashauriwa kwenda"
    },
    {
      "id": "pg026_n0019",
      "text": "hospitalini."
    },
    {
      "id": "pg026_n0020",
      "text": "Taja vifaa vinavyotumika kusafishia masikio"
    },
    {
      "id": "pg026_n0021",
      "text": "Vifaa"
    },
    {
      "id": "pg026_n0022",
      "text": "Hatua za kusafisha masikio"
    },
    {
      "id": "pg026_n0023",
      "text": "1."
    },
    {
      "id": "pg026_n0024",
      "text": "Loweka kitambaa safi na laini katika maji safi."
    },
    {
      "id": "pg026_n0025",
      "text": "2."
    },
    {
      "id": "pg026_n0026",
      "text": "Paka sabuni kwenye kitambaa kilicholowana."
    },
    {
      "id": "pg026_n0027",
      "text": "20"
    },
