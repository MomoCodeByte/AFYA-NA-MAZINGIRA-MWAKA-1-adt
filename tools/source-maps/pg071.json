  "transcript": [
    {
      "id": "pg071_n0001",
      "text": "Zoezi la 2"
    },
    {
      "id": "pg071_n0002",
      "text": "Andika sentensi nne kwa kufuata mtiririko wa picha."
    },
    {
      "id": "pg071_n0003",
      "text": "Kazi ya kufanya"
    },
    {
      "id": "pg071_n0004",
      "text": "Kwa kushirikiana na wenzako fanya igizo kuonesha namna ya"
    },
    {
      "id": "pg071_n0005",
      "text": "kutoa huduma ya kwanza."
    },
    {
      "id": "pg071_n0006",
      "text": "Soma habari ifuatayo, kisha jibu maswali."
    },
    {
      "id": "pg071_n0007",
      "text": "Shukuru na Tuli wanasoma shule ya Maarifa."
    },
    {
      "id": "pg071_n0008",
      "text": "Siku moja Tuli"
    },
    {
      "id": "pg071_n0009",
      "text": "alimuuliza mama yake."
    },
    {
      "id": "pg071_n0010",
      "text": "Mbona hatuna sanduku la huduma"
    },
    {
      "id": "pg071_n0011",
      "text": "ya kwanza?"
    },
    {
      "id": "pg071_n0012",
      "text": "Mama yake akajibu, ukipata tatizo nitakupeleka"
    },
    {
      "id": "pg071_n0013",
      "text": "hospitalini."
    },
    {
      "id": "pg071_n0014",
      "text": "Tuli alisikitika kutokana na lile jibu."
    },
    {
      "id": "pg071_n0015",
      "text": "Siku iliyofuata"
    },
    {
      "id": "pg071_n0016",
      "text": "Shukuru alimpitia Tuli kwenda shule."
    },
    {
      "id": "pg071_n0017",
      "text": "Walipokuwa wanakaribia"
    },
    {
      "id": "pg071_n0018",
      "text": "shuleni, Tuli alianguka akachubuka mguu."
    },
    {
      "id": "pg071_n0019",
      "text": "Shukuru alikimbia"
    },
    {
      "id": "pg071_n0020",
      "text": "kutoa taarifa kwa mwalimu."
    },
    {
      "id": "pg071_n0021",
      "text": "Mwalimu na Shukuru walielekea"
    },
    {
      "id": "pg071_n0022",
      "text": "alipoanguka Tuli."
    },
    {
      "id": "pg071_n0023",
      "text": "Shukuru alichukua sanduku la huduma ya"
    },
    {
      "id": "pg071_n0024",
      "text": "kwanza."
    },
    {
      "id": "pg071_n0025",
      "text": "Shukuru alivaa glovu akasafisha michubuko."
    },
    {
      "id": "pg071_n0026",
      "text": "Alitumia"
    },
    {
      "id": "pg071_n0027",
      "text": "pamba na spiriti ili kuua vijidudu."
    },
    {
      "id": "pg071_n0028",
      "text": "Alipomaliza kumhudumia Tuli, alikusanya pamba na glovu."
    },
    {
      "id": "pg071_n0029",
      "text": "Alihifadhi vifaa hivyo sehemu husika."
    },
    {
      "id": "pg071_n0030",
      "text": "Vilevile alinawa mikono"
    },
    {
      "id": "pg071_n0031",
      "text": "kwa maji safi na sabuni."
    },
    {
      "id": "pg071_n0032",
      "text": "Mwalimu na Shukuru walimpeleka"
    },
    {
      "id": "pg071_n0033",
      "text": "Tuli zahanati kupata matibabu."
    },
    {
      "id": "pg071_n0034",
      "text": "Tuli aliporudi nyumbani"
    },
    {
      "id": "pg071_n0035",
      "text": "alimsimulia mama yake yaliyompata."
    },
    {
      "id": "pg071_n0036",
      "text": "Mama yake alimpa pole."
    },
    {
      "id": "pg071_n0037",
      "text": "Kisha aliwashukuru sana Mwalimu na Shukuru."
    },
    {
      "id": "pg071_n0038",
      "text": "Aliona umuhimu wa sanduku la huduma ya kwanza."
    },
    {
      "id": "pg071_n0039",
      "text": "Hivyo"
    },
    {
      "id": "pg071_n0040",
      "text": "Tuli alitengeneza sanduku la huduma ya kwanza."
    },
    {
      "id": "pg071_n0041",
      "text": "Mama yake"
    },
    {
      "id": "pg071_n0042",
      "text": "alinunua sabuni, pini, wembe na spiriti."
    },
    {
      "id": "pg071_n0043",
      "text": "Aliongeza pamba,"
    },
    {
      "id": "pg071_n0044",
      "text": "plasta, mkasi na bandeji."
    },
    {
      "id": "pg071_n0045",
      "text": "Tuli aliweka vifaa hivyo kwenye"
    },
